# ==============================================================================
# POVIXA ECOSYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=8080

# ------------------------------------------------------------------------------
# Database: PostgreSQL 18 Alpine
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=povixa
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/povixa?sslmode=disable

# ------------------------------------------------------------------------------
# In-Memory Cache & Session Store: Redis 8 Alpine
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=pvx_access_secret_super_secure_key_32chars_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=pvx_refresh_secret_super_secure_key_32chars_min!
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=pvx_cookie_secret_super_secure_salt_here!

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ------------------------------------------------------------------------------
# Multi-Channel OAuth Providers Configuration (App Users)
# ------------------------------------------------------------------------------
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/v1/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:8080/v1/auth/discord/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8080/v1/auth/facebook/callback
