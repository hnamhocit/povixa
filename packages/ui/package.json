{
  "name": "@povixa/ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/ui/*/index.ts",
      "svelte": "./src/components/ui/*/index.ts",
      "default": "./src/components/ui/*/index.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "ui:add": "shadcn-svelte add"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/lora": "^5.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@povixa/tailwind-theme": "workspace:*",
    "bits-ui": "^1.0.0",
    "cn": "^0.4.0",
    "tailwind-variants": "^0.2.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tabler/icons-svelte": "^3.20.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
